{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight",
  "scroll_speed": 3,
  "scroll_acceleration": { "enabled": false },
  "diff_style": "auto",
  "cursor": {
    "style": "line",
    "blinking": true
  },
  "mouse": true,
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.3
  },
  "keybinds": {
    "leader": "ctrl+x",
    "messages_page_up": ["pageup", "ctrl+u"],
    "messages_page_down": ["pagedown", "ctrl+d"],
    "messages_half_page_up": ["shift+up", "ctrl+alt+u"],
    "messages_half_page_down": ["shift+down", "ctrl+alt+d"],
    "messages_line_up": ["ctrl+up", "ctrl+alt+y"],
    "messages_line_down": ["ctrl+down", "ctrl+alt+e"],
    "messages_first": ["home", "ctrl+home"],
    "messages_last": ["end", "ctrl+end"]
  }
}
