{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight",
  "scroll_speed": 5,
  "scroll_acceleration": { "enabled": true },
  "diff_style": "auto",
  "cursor": {
    "style": "bar",
    "blinking": true
  },
  "mouse": true,
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.3
  },
  "keybinds": {
    "leader": "ctrl+x"
  }
}
